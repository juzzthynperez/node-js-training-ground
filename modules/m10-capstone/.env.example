# M10 capstone — local environment template.
# Commit .env.example; never commit .env or .env.test (arch doc conventions).

# Prisma — SQLite database file (read by prisma7.config.ts and src/db.ts).
DATABASE_URL="file:./dev.db"

# App config — validated once at startup by src/config.ts (Zod, fail fast).
PORT=3000
NODE_ENV=development

# Auth — JWT signing secret. MINIMUM 32 characters. Set a real secret in
# your local .env (e.g. `openssl rand -hex 32`); never hard-code it in
# source, never commit it. The placeholder below only satisfies the
# length check for a fresh local dev copy.
JWT_SECRET="local-dev-secret-replace-me-0123456789abcdef"
JWT_EXPIRES_IN=1h

# Password hashing cost — bcrypt work factor (4..15). 10 is a sensible
# development default; tests force 4 for speed via tests/setup-env.mjs.
BCRYPT_ROUNDS=10

# Rate limiting — applied to /auth/register and /auth/login only.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
