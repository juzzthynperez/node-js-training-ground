meta {
  name: Create contested book (librarian, dynamic isbn -> 201)
  type: http
  seq: 23
}

script:pre-request {
  // Fresh contested copy per run ("bl-" keeps the isbn within 20 chars).
  bru.setVar("loanBookIsbn", "bl-" + Date.now());
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{jwtLibrarian}}
}

body:json {
  {
    "title": "Bruno: Contested Copy",
    "isbn": "{{loanBookIsbn}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  const body = res.getBody();
  bru.setVar("loanBookId", body.id);
}

tests {
  test("contested copy created and available", function() {
    const body = res.getBody();
    expect(body.available).to.equal(true);
    expect(body.id).to.be.a("string");
  });
}
