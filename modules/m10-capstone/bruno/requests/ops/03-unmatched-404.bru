meta {
  name: Unmatched route -> 404 envelope (no auth needed)
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/api/v1/definitely-not-a-route
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
}

tests {
  test("unmatched routes use the shared envelope with a generated request id", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("NOT_FOUND");
    expect(body.error.message).to.contain("not found");
    expect(body.error.requestId).to.be.a("string");
    expect(body.error.requestId.length).to.be.greaterThan(0);
  });

  test("response carries x-request-id even on 404", function() {
    const headers = res.getHeaders();
    const rid = headers["x-request-id"] ?? headers["X-Request-Id"];
    expect(rid).to.be.a("string");
    expect(rid.length).to.be.greaterThan(0);
  });
}
