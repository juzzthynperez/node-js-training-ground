meta {
  name: Inbound x-request-id is echoed
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: inherit
}

headers {
  x-request-id: bruno-trace-001
}

assert {
  res.status: eq 200
}

tests {
  test("our id comes back on the response", function() {
    const headers = res.getHeaders();
    const echoed = headers["x-request-id"] ?? headers["X-Request-Id"];
    expect(echoed).to.equal("bruno-trace-001");
  });
}
