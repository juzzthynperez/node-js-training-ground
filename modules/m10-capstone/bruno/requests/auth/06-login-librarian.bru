meta {
  name: Login seeded librarian -> 200 + token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "librarian@library.test",
    "password": "librarian-pass-123"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  bru.setVar("jwtLibrarian", body.token);
}

tests {
  test("librarian token carries the LIBRARIAN role", function() {
    const body = res.getBody();
    expect(body.token).to.be.a("string");
    expect(body.user.role).to.equal("LIBRARIAN");
  });
}
