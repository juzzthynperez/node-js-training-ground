meta {
  name: Login wrong password -> 401 (same message as unknown email)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "member@library.test",
    "password": "definitely-wrong-1"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("wrong password answers the anti-enumeration message", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("UNAUTHORIZED");
    expect(body.error.message).to.equal("Invalid email or password");
  });
}
