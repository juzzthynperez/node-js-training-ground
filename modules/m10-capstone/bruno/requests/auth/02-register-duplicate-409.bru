meta {
  name: Register duplicate email -> 409
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno Reader Again",
    "email": "{{registerEmail}}",
    "password": "bruno-pass-123"
  }
}

assert {
  res.status: eq 409
}

tests {
  test("duplicate answers the CONFLICT envelope, no details", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("CONFLICT");
    expect(body.error.message).to.be.a("string");
    expect(body.error).to.not.have.property("details");
  });
}
