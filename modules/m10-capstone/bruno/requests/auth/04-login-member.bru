meta {
  name: Login seeded member -> 200 + token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "member@library.test",
    "password": "member-pass-123"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  bru.setVar("jwt", body.token);
  bru.setVar("jwtUserId", body.user.id);
}

tests {
  test("login answers 200 with a token for the seeded member", function() {
    const body = res.getBody();
    expect(body.token).to.be.a("string");
    expect(body.user.email).to.equal("member@library.test");
    expect(body.user.role).to.equal("MEMBER");
  });
}
