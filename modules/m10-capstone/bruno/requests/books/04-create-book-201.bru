meta {
  name: Create book (librarian, dynamic isbn -> 201)
  type: http
  seq: 17
}

script:pre-request {
  // Timestamped isbn: rerun-safe against a live server with real unique
  // constraints (the duplicate demo reuses this exact variable).
  bru.setVar("bookIsbn", "bruno-" + Date.now());
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{jwtLibrarian}}
}

body:json {
  {
    "title": "Bruno: Created Book",
    "isbn": "{{bookIsbn}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  const body = res.getBody();
  bru.setVar("bookId", body.id);
}

tests {
  test("responds 201 with the created book and an empty author set", function() {
    const body = res.getBody();
    expect(body.title).to.equal("Bruno: Created Book");
    expect(body.isbn).to.equal(bru.getVar("bookIsbn"));
    expect(body.available).to.equal(true);
    expect(body.authors).to.deep.equal([]);
    expect(body.id).to.be.a("string");
  });
}
