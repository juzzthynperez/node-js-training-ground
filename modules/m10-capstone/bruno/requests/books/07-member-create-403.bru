meta {
  name: Create book as MEMBER -> 403 (role gate)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "title": "Should Never Be Created",
    "isbn": "bruno-403-gate"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("wrong role answers FORBIDDEN through the envelope", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("FORBIDDEN");
    expect(body.error.message).to.contain("role");
  });
}
