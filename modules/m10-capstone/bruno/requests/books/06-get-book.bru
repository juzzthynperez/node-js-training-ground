meta {
  name: Get book by id -> 200
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/books/{{bookId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  test("detail matches the created row", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("bookId"));
    expect(body.title).to.equal("Bruno: Created Book");
    expect(body.authors).to.be.an("array");
  });
}
