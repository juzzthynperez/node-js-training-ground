meta {
  name: Delete author (librarian -> 204)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/v1/authors/{{authorId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{jwtLibrarian}}
}

assert {
  res.status: eq 204
}

tests {
  test("deletion answers 204 with an empty body", function() {
    expect(res.getBody()).to.satisfy((b) => b === null || b === undefined || (Array.isArray(b) === false && Object.keys(b).length === 0));
  });
}
