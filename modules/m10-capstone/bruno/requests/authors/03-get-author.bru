meta {
  name: Get author by id -> 200 with books
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/authors/{{authorId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  test("detail view carries the author and a books array (M:N side)", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("authorId"));
    expect(body.books).to.be.an("array");
  });

  test("detail returns exactly what create stored (create -> get round trip)", function() {
    const body = res.getBody();
    expect(body.name).to.equal("Bruno Author");
    expect(body.bio).to.equal("Created by the Bruno collection run");
    expect(body.createdAt).to.be.a("string");
  });
}
