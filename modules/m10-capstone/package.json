{
  "name": "m10-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "M10 capstone: Library API — Express 5 + TypeScript 7 strict + Prisma 7 (SQLite) + Zod 4 + Jest 30/Supertest 7, with bcrypt hashing, JWT auth, role-based authorization, rate-limited auth endpoints, and a transaction-proven race fix.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test:bruno": "cd bruno && bru run --env local",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prove:race": "tsx scripts/prove-race.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@usebruno/cli": "^4.2.1",
    "dotenv": "^18.0.8",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true,
    "prisma@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true
  }
}
