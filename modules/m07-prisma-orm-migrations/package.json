{
  "name": "m07-prisma-orm-migrations",
  "version": "1.0.0",
  "private": true,
  "description": "M07 practical: Task API v2 — Prisma 7 ORM on SQLite with migrations, a typed service layer, seeding, and Prisma error mapping",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test:bruno": "cd bruno && bru run --env local",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "prove:errors": "tsx scripts/error-proofs.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.6.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.19.2",
    "@usebruno/cli": "^4.2.1",
    "dotenv": "^18.0.8",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true,
    "prisma@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.1": true
  }
}
