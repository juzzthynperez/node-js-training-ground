# Task API v3 — local environment template.
# Commit .env.example; never commit .env (arch doc repository conventions).

# Prisma — SQLite database file (read by prisma7.config.ts and src/db.ts).
DATABASE_URL="file:./dev.db"

# App config — validated once at startup by src/config.ts (Zod, fail fast).
PORT=3000
NODE_ENV=development
