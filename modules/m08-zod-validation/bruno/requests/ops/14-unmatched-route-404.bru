meta {
  name: Unmatched route (404 envelope)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/nope
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
}

tests {
  test("unmatched route uses the same envelope as resource 404s", function() {
    const err = res.getBody().error;
    expect(err.code).to.equal("NOT_FOUND");
    expect(err.message).to.include("Route GET");
    expect(err.requestId).to.be.a("string");
  });
}
