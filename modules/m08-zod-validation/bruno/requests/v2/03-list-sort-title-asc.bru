meta {
  name: v2: sort by title ascending
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tasks?sort=title&order=asc&pageSize=5
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("first page starts at the alphabetically first title", function() {
    const body = res.getBody();
    // 18 seed tasks, alphabetical order begins 'Book dentist appointment'.
    expect(body.data[0].title).to.equal("Book dentist appointment");
    expect(body.data[1].title).to.equal("Buy coffee beans");
  });

  test("titles are strictly ascending", function() {
    const body = res.getBody();
    for (let i = 1; i < body.data.length; i++) {
      expect(body.data[i - 1].title < body.data[i].title).to.equal(true);
    }
  });
}
