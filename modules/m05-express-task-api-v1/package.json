{
  "name": "m05-express-task-api-v1",
  "version": "1.0.0",
  "private": true,
  "description": "M05 practical: Task API v1 — in-memory Express 5 REST API with middleware, central error handling, and a Bruno collection",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test:bruno": "cd bruno && bru run --env local"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.19.2",
    "@usebruno/cli": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true
  }
}
