meta {
  name: Delete task (already deleted -> 404)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/v1/tasks/{{createdTaskId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
}

tests {
  test("second delete is a 404 envelope", function() {
    const err = res.getBody().error;
    expect(err.code).to.equal("NOT_FOUND");
  });
}
